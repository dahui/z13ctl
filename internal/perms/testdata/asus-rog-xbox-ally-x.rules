# 99-voltaire.rules — voltaire's device access on this machine.
# Generated by: voltaire setup
# Device: asus-rog-xbox-ally-x, group: users, voltaire test
# Rewritten by `sudo voltaire setup`; removed by `sudo voltaire setup --remove`.
# Grants the group only what this machine's device file needs; the boot pass
# (voltaire-perms.service) applies the same grants to attributes that appear
# after their udev event.

# lighting: Joystick rings
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1b4c", ENV{ID_USB_INTERFACE_NUM}=="02", MODE="0660", GROUP="users"

# button: Armoury Crate button (read only)
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="ASUS ROG Ally X Gamepad", ENV{ID_INPUT_KEYBOARD}!="1", MODE="0640", GROUP="users"

# profiles: firmware performance profile
ACTION=="add", SUBSYSTEM=="platform-profile", RUN+="/bin/sh -c 'for f in /sys%p/profile; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# fans: custom fan curve points and mode
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="asus_custom_fan_curve", RUN+="/bin/sh -c 'for f in /sys%p/pwm*; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# fans: fan mode (full speed, auto)
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="asus", RUN+="/bin/sh -c 'for f in /sys%p/pwm*_enable; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# power: TDP (asus-armoury PPT limits)
ACTION=="add", SUBSYSTEM=="firmware-attributes", KERNEL=="asus-armoury", RUN+="/bin/sh -c 'for f in /sys/class/firmware-attributes/asus-armoury/attributes/ppt_*/current_value; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# power: TDP (asus-nb-wmi PPT limits, the fallback)
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="asus-nb-wmi", RUN+="/bin/sh -c 'for f in /sys/devices/platform/asus-nb-wmi/ppt_*; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# toggles: firmware switches (boot_sound, panel_overdrive, mcu_powersave)
ACTION=="add", SUBSYSTEM=="firmware-attributes", KERNEL=="asus-armoury", RUN+="/bin/sh -c 'for f in /sys/class/firmware-attributes/asus-armoury/attributes/boot_sound/current_value /sys/class/firmware-attributes/asus-armoury/attributes/panel_overdrive/current_value /sys/class/firmware-attributes/asus-armoury/attributes/mcu_powersave/current_value; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# battery: charge limit
ACTION=="add|change", SUBSYSTEM=="power_supply", ATTR{type}=="Battery", RUN+="/bin/sh -c 'for f in /sys%p/charge_control_end_threshold; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# cpu: CPU boost switch
# No udev rule can reach /sys/devices/system/cpu/cpufreq/boost; voltaire-perms.service grants it at boot.

# telemetry: package power (RAPL energy counter, read only)
ACTION=="add", SUBSYSTEM=="powercap", ATTR{name}=="package-0", RUN+="/bin/sh -c 'for f in /sys%p/energy_uj; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+r \"$$f\"; done'"
