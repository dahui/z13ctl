# 99-voltaire.rules — voltaire's device access on this machine.
# Generated by: voltaire setup
# Device: onexplayer-x2-mini-pro, group: users, voltaire test
# Rewritten by `sudo voltaire setup`; removed by `sudo voltaire setup --remove`.
# Grants the group only what this machine's device file needs; the boot pass
# (voltaire-perms.service) applies the same grants to attributes that appear
# after their udev event.

# button: Home button
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="fe00", ENV{ID_USB_INTERFACE_NUM}=="02", MODE="0640", GROUP="users"

# button: Keyboard button (read only)
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="HID 1a86:fe00", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="fe00", ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{[dmi/id]sys_vendor}=="ONE-NETBOOK", ATTR{[dmi/id]product_name}=="ONEXPLAYER X2Mini PRO", MODE="0640", GROUP="users"

# profiles: firmware performance profile
ACTION=="add", SUBSYSTEM=="platform-profile", RUN+="/bin/sh -c 'for f in /sys%p/profile; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"

# cpu: CPU boost switch
# No udev rule can reach /sys/devices/system/cpu/cpufreq/boost; voltaire-perms.service grants it at boot.

# smu: ryzen_smu mailbox (TDP or undervolt)
# No udev rule can reach /sys/kernel/ryzen_smu_drv/smu_args /sys/kernel/ryzen_smu_drv/mp1_smu_cmd /sys/kernel/ryzen_smu_drv/rsmu_cmd; voltaire-perms.service grants it at boot.

# telemetry: package power (RAPL energy counter, read only)
ACTION=="add", SUBSYSTEM=="powercap", ATTR{name}=="package-0", RUN+="/bin/sh -c 'for f in /sys%p/energy_uj; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+r \"$$f\"; done'"

# rumble: controller vibration strength
ACTION=="bind", SUBSYSTEM=="hid", DRIVER=="hid-oxp", RUN+="/bin/sh -c 'for f in /sys%p/rumble_intensity; do [ -e \"$$f\" ] || continue; chgrp users \"$$f\" && chmod g+w \"$$f\"; done'"
