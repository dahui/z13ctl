post_install() {
    udevadm control --reload-rules
    udevadm trigger

    # setup writes the udev rules and the perms unit, applies sysfs permissions
    # immediately, and cleans up what a pre-2.0 "z13ctl setup" installed (the
    # old rules file — only after verifying z13ctl generated it — and the old
    # RemainAfterExit perms unit, which stays active holding stale grants
    # through anything short of an explicit disable).
    voltaire setup

    # CAP_BPF + CAP_PERFMON let the gamescope overlay block controller input at
    # the kernel level instead of freezing Steam. Optional — the SIGSTOP
    # fallback works without them.
    setcap cap_bpf,cap_perfmon+ep /usr/bin/voltaire-gui 2>/dev/null || true

    # The old user units are not setup's to manage; replace them here. Their
    # sockets stay served: voltaire.socket carries the pre-rename listen path
    # too, so clients pointed at the z13ctl socket keep working.
    systemctl --global disable z13ctl.socket z13ctl.service z13gui.service 2>/dev/null || true
    systemctl --global enable voltaire.socket voltaire.service || true
    systemctl --global enable voltaire-gui.service || true

    echo ""
    echo ">>> voltaire installed (CLI, daemon, and the voltaire-gui overlay)."
    echo ">>> To start now without logging out:"
    echo ">>>   systemctl --user start voltaire.socket voltaire-gui.service"
    echo ">>> Or log out and back in — both start automatically."
    echo ">>> Upgrading from z13ctl/z13gui? Settings carry over on first run:"
    echo ">>>   https://dahui.github.io/voltaire/migrating-from-z13ctl/"
}

post_upgrade() {
    udevadm control --reload-rules
    udevadm trigger
    # Re-run so an upgrade applies added permission grants without a reboot.
    voltaire setup
    setcap cap_bpf,cap_perfmon+ep /usr/bin/voltaire-gui 2>/dev/null || true
    echo ""
    echo ">>> voltaire upgraded. Reload the user daemon and restart:"
    echo ">>>   systemctl --user daemon-reload"
    echo ">>>   systemctl --user restart voltaire.service voltaire-gui.service"
}
