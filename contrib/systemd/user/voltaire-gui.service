[Unit]
Description=voltaire-gui - GTK4 overlay drawer for voltaire
Documentation=https://github.com/dahui/voltaire
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=voltaire-gui
Environment=GTK_A11Y=none
EnvironmentFile=-%t/gamescope-environment
Restart=on-failure
RestartSec=3
ExecStopPost=/bin/sh -c 'kill -CONT $(cat /run/user/%U/voltaire-gui-frozen-pid 2>/dev/null) 2>/dev/null; rm -f /run/user/%U/voltaire-gui-frozen-pid'

[Install]
WantedBy=graphical-session.target
